# The variables a production API reads, for reference. On Cloud Run,
# infra/locals.tf (api_env) and infra/cloud_run.tf set every one of them, so
# nothing reads this file there. Copy it only to run the production image by
# hand (scripts/prod-image.sh runs it with the same set).

# Off by default; production must never turn it on.
DJANGO_DEBUG=False
# Required with DEBUG off. On Cloud Run it comes from Secret Manager.
DJANGO_SECRET_KEY=generate-a-long-random-value
# The service's own hosts only: on Cloud Run, its run.app URL and its
# candidate revision's.
ALLOWED_HOSTS=api.example.com
# One proxy (Cloud Run's front end). Throttles count each client by the
# address it saw; 0 would count every request as the proxy's own.
DJANGO_NUM_PROXIES=1
SECURE_SSL_REDIRECT=True

# The web app's origins.
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com

# Firestore (credentials come from the Cloud Run service account) and the
# bucket uploads go to.
FIRESTORE_PROJECT_ID=your-gcp-project-id
GS_BUCKET_NAME=your-gcp-project-id-media

# Auth0
AUTH0_DOMAIN=b1codes.us.auth0.com
AUTH0_AUDIENCE=https://api.mapmyfriends.com/
