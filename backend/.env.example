# Django Settings
DJANGO_SECRET_KEY=your-production-secret-key-here
DJANGO_DEBUG=False
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,EC2-PUBLIC-IP
# Proxies in front of Django: nginx. Throttles count each client by the
# address nginx saw; 0 would count every request as nginx's own address.
DJANGO_NUM_PROXIES=1
# Once nginx serves HTTPS: redirect plain HTTP to it.
SECURE_SSL_REDIRECT=True

# Database Settings
DATABASE_URL=postgis://mapuser:secure-password@db:5432/mapfriends_db
POSTGRES_DB=mapfriends_db
POSTGRES_USER=mapuser
POSTGRES_PASSWORD=secure-password

# CORS/CSRF Settings
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com

# Auth0 Settings
AUTH0_DOMAIN=b1codes.us.auth0.com
AUTH0_AUDIENCE=https://api.mapmyfriends.com/

