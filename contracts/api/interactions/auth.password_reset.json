{
  "description": "Ask for a password reset email. The response must not reveal whether the address has an account.",
  "consumer": "AuthService.requestPasswordReset",
  "provider_state": "anonymous",
  "request": {
    "method": "POST",
    "path": "user/auth/password-reset/",
    "auth": "none",
    "json": { "email": "nobody@example.com" }
  },
  "response": {
    "status": 200,
    "schema": "Message",
    "example": { "message": "Password reset email sent." }
  }
}
