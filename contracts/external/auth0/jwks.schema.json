{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auth0 JSON Web Key Set",
  "description": "PyJWKClient picks the key whose kid matches the token header and verifies an RS256 signature with it, so at least one RSA signing key with a kid must be present.",
  "type": "object",
  "required": [
    "keys"
  ],
  "properties": {
    "keys": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": [
          "kty",
          "kid",
          "n",
          "e"
        ],
        "properties": {
          "kty": {
            "const": "RSA"
          },
          "kid": {
            "type": "string",
            "minLength": 1
          },
          "use": {
            "const": "sig"
          },
          "alg": {
            "const": "RS256"
          },
          "n": {
            "type": "string",
            "minLength": 1
          },
          "e": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
