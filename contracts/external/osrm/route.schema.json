{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSRM route response, as RoutingService reads it",
  "description": "Only what the client depends on is pinned down; OSRM may add fields freely. RoutingService reads routes[0].geometry.coordinates as [longitude, latitude] pairs, and treats anything else as 'no route' and draws a straight line.",
  "type": "object",
  "required": [
    "code",
    "routes"
  ],
  "properties": {
    "code": {
      "const": "Ok"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "geometry"
        ],
        "properties": {
          "geometry": {
            "type": "object",
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "const": "LineString"
              },
              "coordinates": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    }
                  ],
                  "minItems": 2
                }
              }
            }
          },
          "distance": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
