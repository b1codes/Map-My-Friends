{
  "description": "One state's stations and halts, as fetch_stations requests them (it loops over every US state; Rhode Island is the smallest). Whitespace in the query is not significant.",
  "consumer": "manage.py fetch_stations (backend)",
  "provider": "Overpass API (overpass-api.de)",
  "live": true,
